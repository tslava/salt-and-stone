{
  "name": "salt-and-stone",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && prettier --check index.html src scripts tests",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/tap-browser-test.mjs",
    "format": "prettier --write index.html src scripts tests"
  },
  "devDependencies": {
    "playwright": "1.59.1",
    "prettier": "3.9.6"
  }
}
